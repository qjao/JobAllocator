# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NRE_STAFF_TOKEN: Required for National Rail Enquiries OpenLDBWS.
# Users configure this via the Secrets panel in the AI Studio UI.
NRE_STAFF_TOKEN="MY_NRE_TOKEN"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Recipient email address for new user registration alerts.
ADMIN_EMAIL="admin@example.com"

# SMTP Configuration: Used for sending password recovery links and admin alerts.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp_username_or_apikey"
SMTP_PASS="smtp_password_or_token"
SMTP_FROM="Instructor Job Allocator <noreply@example.com>"
