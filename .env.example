# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NR_LIVE_API_URL / NR_LIVE_API_KEY: Remote FastAPI service URL and x-api-key for Find Jobs (/api/live).
# Can also be configured in Admin > Live Train API.
NR_LIVE_API_URL="https://your-live-train-api.example.com"
NR_LIVE_API_KEY="your_api_secret_key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Recipient email address for new user registration alerts.
ADMIN_EMAIL="admin@example.com"

# SMTP Configuration: Used for sending password recovery links and admin alerts.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp_username_or_apikey"
SMTP_PASS="smtp_password_or_token"
SMTP_FROM="Instructor Job Allocator <noreply@example.com>"
